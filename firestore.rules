rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Admin Checks =====
    function isSuperAdmin() {
      // SYNC: ADMIN_EMAILS — Mirror changes here in js/firebase-config.js → ADMIN_EMAILS array
      // ⚠️  Both lists must always contain the same emails. See firebase-config.js comment.
      return request.auth != null && (
        request.auth.token.email in ['admin@dsu.edu','loganathan@dsu.edu','mloganathan082008@gmail.com','exampro.loganathanm.in@gmail.com'] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super' ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'staff'))
      );
    }

    function isDeptAdmin(dept) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'department' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.department == dept;
    }

    function isAnyAdmin() {
      return isSuperAdmin() || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ===== Admins Collection =====
    match /admins/{uid} {
      allow read: if request.auth != null; // Required for client-side admin checks
      allow write: if isSuperAdmin();
    }

    // ===== OTP Verifications =====
    match /otpVerifications/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Students Collection =====
    // ⚠️  SECURITY FIX: was allow read: if true — changed to auth-required.
    // Public result checking must go through /publicResults collection (read-only,
    // populated by admin/Cloud Function) — never via bulk-read of this collection.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == studentId;
      allow update: if request.auth != null && (
        request.auth.uid == studentId ||
        isSuperAdmin() ||
        isDeptAdmin(resource.data.department)
      );
      allow delete: if isSuperAdmin();

      // Subcollection: Login History
      match /loginHistory/{entryId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == studentId;
        allow update: if false;
      }

      // Subcollection: Activity Logs (Section 8)
      match /activityLogs/{logId} {
        allow read: if request.auth != null && (request.auth.uid == studentId || isAnyAdmin());
        allow create: if request.auth != null && request.auth.uid == studentId;
        allow update, delete: if isSuperAdmin();
      }
    }

    // ===== Public Results (minimal, no PII — for check-result page) =====
    // Fields: registerNumber, nameMasked, marks, percentage, department, testTitle
    // Populated by admin write only — never directly by students.
    match /publicResults/{id} {
      allow read: if true; // Public check-result page uses this
      allow write: if isAnyAdmin();
    }

    // ===== Results Collection =====
    // ⚠️  SECURITY FIX: was allow read: if true — changed to auth-required.
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || isDeptAdmin(resource.data.department);
    }

    // ===== Direct Messages =====
    match /directMessages/{msgId} {
      allow read, update: if request.auth != null && (resource.data.studentId == request.auth.uid || isAnyAdmin());
      allow create, delete: if isAnyAdmin();
    }

    // ===== Feedback Collection =====
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAnyAdmin();
    }

    // ===== Tests Collection =====
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow create: if isSuperAdmin() || isDeptAdmin(request.resource.data.department);
      allow update, delete: if isSuperAdmin() || isDeptAdmin(resource.data.department);
    }

    // ===== Malpractice Logs =====
    match /malpracticeLogs/{logId} {
      allow read: if isAnyAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // ===== Courses Collection =====
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin();
    }

    // ===== Announcements / Notice Board / Exam Schedule =====
    match /announcements/{id} { allow read: if request.auth != null; allow write: if isAnyAdmin(); }
    match /notices/{id} { allow read: if request.auth != null; allow write: if isAnyAdmin(); }
    match /exam_schedule/{id} { allow read: if request.auth != null; allow write: if isAnyAdmin(); }

    // ===== Notifications (admin → student, and registration triggers) =====
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        resource.data.targetUID == request.auth.uid || isAnyAdmin()
      );
      allow create: if request.auth != null; // Students create on registration
      allow update, delete: if isAnyAdmin();
    }

    // ===== Staff Collection =====
    match /staff/{staffId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin();
    }

    // ===== Settings (Maintenance Mode, global config) =====
    // Section 3: settings/maintenanceMode document
    match /settings/{docId} {
      allow read: if true; // All pages (including logged-out) need to check maintenance status
      allow write: if isSuperAdmin();
    }

    // ===== Study Materials (Section 4) =====
    match /studyMaterials/{materialId} {
      allow read: if request.auth != null;
      allow create, delete: if isAnyAdmin();
      allow update: if isAnyAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'viewsCount']));
    }

    // ===== Achievements (Section 9) =====
    match /achievements/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentUID == request.auth.uid;
      allow update: if isAnyAdmin(); // Admin marks verified
      allow delete: if isSuperAdmin() || (request.auth != null && resource.data.studentUID == request.auth.uid && resource.data.verified == false);
    }

    // ===== Study Planner (Section 6) =====
    match /studyPlans/{uid}/tasks/{taskId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Revision Logs (Section 6) =====
    match /revisionLogs/{uid}/{dateId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Assignments (Section 6 — admin/staff created) =====
    match /assignments/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin();
    }

    // ===== Backlogs (Section 6) =====
    match /backlogs/{uid}/{subjectId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAnyAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAnyAdmin());
      allow delete: if isAnyAdmin();
    }

    // ===== Community: Chat Rooms (Section 7) =====
    match /chatRooms/{department}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false; // No edits
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.senderUID == request.auth.uid);
    }

    // ===== Community: Project Listings (Section 7) =====
    match /projectListings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
      allow delete: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
    }

    // ===== Community: Study Groups (Section 7) =====
    match /studyGroups/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
      allow delete: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
    }

    // ===== Community: Polls (Section 7) =====
    match /polls/{id} {
      allow read: if request.auth != null;
      allow create: if isAnyAdmin() || request.auth != null;
      allow update: if request.auth != null; // Vote update
      allow delete: if isAnyAdmin();
    }

    // ===== Community: Forum (Section 7) =====
    match /forumThreads/{threadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.authorUID == request.auth.uid || isAnyAdmin());
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.authorUID == request.auth.uid);

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (resource.data.authorUID == request.auth.uid || isAnyAdmin());
        allow delete: if isAnyAdmin() || (request.auth != null && resource.data.authorUID == request.auth.uid);
      }
    }

    // ===== Community: Lost & Found (Section 7) =====
    match /lostAndFound/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.reporterUID == request.auth.uid || isAnyAdmin());
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.reporterUID == request.auth.uid);
    }

    // ===== QR Login Sessions (Section 8 — Cloud Function managed) =====
    match /qrSessions/{token} {
      allow read: if request.auth != null;
      allow create: if false; // Only Cloud Function creates these
      allow update: if request.auth != null; // Flutter app claims the session
      allow delete: if false; // Cloud Function TTL cleanup only
    }

    // ===== Deny all other access =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
