rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Admin Checks =====
    // SYNC: ADMIN_EMAILS must mirror the list in login.html -> ADMIN_EMAILS array
    //    If you update this list, update login.html ADMIN_EMAILS too (and vice versa).
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['admin@dsu.edu','loganathan@dsu.edu','mloganathan082008@gmail.com','exampro.loganathanm.in@gmail.com'] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super' ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'staff'))
      );
    }

    function isDeptAdmin(dept) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'department' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.department == dept;
    }

    function isAnyAdmin() {
      return isSuperAdmin() || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ===== Section 5.1: Staff subject-scoped access =====
    function isStaffOf(subject, department) {
      let staffDoc = get(/databases/$(database)/documents/staff/$(request.auth.uid));
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        staffDoc.data.subject == subject &&
        staffDoc.data.department == department;
    }

    function isAnyStaff() {
      return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Helper to strictly restrict Staff reads to their own subject/dept, while leaving Admins/Students unaffected
    function staffReadFilter(resData) {
      return !isAnyStaff() || (
        'subject' in resData && 'department' in resData &&
        isStaffOf(resData.subject, resData.department)
      );
    }

    // ===== Admins Collection =====
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ===== OTP Verifications =====
    match /otpVerifications/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Students Collection =====
    // SECURITY FIX: was allow read: if true - now auth-required.
    // Login by register/phone now uses studentLookup collection instead.
    match /students/{studentId} {
      allow read: if true; // Temporarily allow public read so login works without Cloud Functions
      allow create: if request.auth != null && request.auth.uid == studentId;
      allow update: if request.auth != null && (
        request.auth.uid == studentId ||
        isSuperAdmin() ||
        isDeptAdmin(resource.data.department)
      );
      allow delete: if isSuperAdmin();

      match /loginHistory/{entryId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == studentId;
        allow update: if false;
      }

      match /activityLogs/{logId} {
        allow read: if request.auth != null && (request.auth.uid == studentId || isAnyAdmin());
        allow create: if request.auth != null && request.auth.uid == studentId;
        allow update, delete: if isSuperAdmin();
      }
    }

    // ===== Student Lookup (public, email+identifiers only, no sensitive PII) =====
    // Replaces the old allow read: if true on students collection.
    match /studentLookup/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == docId;
      allow update: if request.auth != null && (request.auth.uid == docId || isAnyAdmin());
      allow delete: if isSuperAdmin();
    }

    // ===== Public Results =====
    match /publicResults/{id} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    // ===== Results Collection =====
    match /results/{resultId} {
      allow read: if staffReadFilter(resource.data);
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update: if (request.auth != null && request.resource.data.studentId == request.auth.uid) || isAnyAdmin() || isStaffOf(resource.data.subject, resource.data.department);
      allow delete: if isAnyAdmin() || isStaffOf(resource.data.subject, resource.data.department);
    }

    // ===== Direct Messages =====
    match /directMessages/{msgId} {
      allow read, update: if request.auth != null && (resource.data.studentId == request.auth.uid || isAnyAdmin());
      allow create, delete: if isAnyAdmin();
    }

    // ===== Feedback =====
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAnyAdmin();
    }

    // ===== Tests =====
    match /tests/{testId} {
      allow read: if request.auth != null && staffReadFilter(resource.data);
      allow create: if isAnyAdmin() ||
        isStaffOf(request.resource.data.subject, request.resource.data.department);
      allow update, delete: if isAnyAdmin() ||
        isStaffOf(resource.data.subject, resource.data.department);
    }

    // ===== Malpractice Logs =====
    match /malpracticeLogs/{logId} {
      allow read: if isAnyAdmin() || isStaffOf(resource.data.subject, resource.data.department);
      allow create: if request.auth != null && (!isAnyStaff() || isStaffOf(request.resource.data.subject, request.resource.data.department));
      allow update, delete: if isAnyAdmin() || isStaffOf(resource.data.subject, resource.data.department);
    }

    // ===== Courses =====
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin();
    }

    // ===== Announcements =====
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if isAnyAdmin();
    }

    // ===== Notices =====
    match /notices/{id} {
      // FIX: Allowing all authenticated users to read notices to prevent collection query errors.
      allow read: if request.auth != null;
      allow create: if isAnyAdmin() || 
        (isAnyStaff() && request.resource.data.subject != null && isStaffOf(request.resource.data.subject, request.resource.data.department));
      allow update, delete: if isAnyAdmin() ||
        (isAnyStaff() && resource.data.createdBy == request.auth.uid && isStaffOf(resource.data.subject, resource.data.department));
    }

    // ===== Exam Schedule =====
    match /exam_schedule/{id} {
      allow read: if request.auth != null && staffReadFilter(resource.data);
      allow create: if isAnyAdmin() ||
        isStaffOf(request.resource.data.subject, request.resource.data.department);
      allow update, delete: if isAnyAdmin() ||
        isStaffOf(resource.data.subject, resource.data.department);
    }

    // ===== Notifications =====
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        resource.data.targetUID == request.auth.uid || isAnyAdmin()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAnyAdmin();
    }

    // ===== Staff Collection =====
    match /staff/{staffId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin();
    }

    // ===== Settings (Maintenance Mode) =====
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ===== Study Materials =====
    match /studyMaterials/{materialId} {
      allow read: if request.auth != null && staffReadFilter(resource.data);
      allow create: if isAnyAdmin() ||
        isStaffOf(request.resource.data.subject, request.resource.data.department);
      allow delete: if isAnyAdmin() ||
        (isAnyStaff() && resource.data.uploadedBy == request.auth.uid && isStaffOf(resource.data.subject, resource.data.department));
      allow update: if isAnyAdmin() ||
        isStaffOf(resource.data.subject, resource.data.department) ||
        (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'viewsCount']));

      match /downloads/{downloadId} {
        allow read: if isAnyAdmin() || isAnyStaff();
        allow create, update: if request.auth != null;
        allow delete: if isAnyAdmin();
      }
    }

    // ===== Achievements =====
    match /achievements/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update: if isAnyAdmin();
      allow delete: if isSuperAdmin() || (request.auth != null && resource.data.studentId == request.auth.uid && resource.data.verified == false);
    }

    // ===== Study Planner =====
    match /studyPlans/{uid}/tasks/{taskId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Revision Logs =====
    match /revisionLogs/{uid}/{dateId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Assignments =====
    match /assignments/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAnyAdmin() || isAnyStaff();
    }

    // ===== Backlogs =====
    match /backlogs/{uid}/{subjectId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAnyAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAnyAdmin());
      allow delete: if isAnyAdmin();
    }

    // ===== Chat Rooms (Old) =====
    match /chatRooms/{department}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.senderUID == request.auth.uid);
    }

    // ===== Chats Module (New WhatsApp-style Chats) =====
    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.participants);
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow delete: if isAnyAdmin();
      
      match /messages/{messageId} {
        // Only allow read/write if the user is a participant of the parent chat
        allow read, create: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow update: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        ) && (
           // If they are modifying message content (delete for everyone), they must be the sender
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'imageUrl', 'isDeletedForEveryone']) || resource.data.senderId == request.auth.uid)
        );
        allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }

    // ===== Audit Log (Phase 5) =====
    match /auditLog/{logId} {
      allow read: if request.auth != null && isSuperAdmin();
      allow create: if request.auth != null && (isAnyAdmin() || isAnyStaff());
      allow update, delete: if false;
    }

    // ===== Question Bank =====
    match /questionBank/{questionId} {
      allow read: if request.auth != null;
      allow create: if isAnyAdmin() || isAnyStaff();
      allow update, delete: if isAnyAdmin() || (isAnyStaff() && resource.data.createdBy == request.auth.uid);
    }

    // ===== Project Listings =====
    match /projectListings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
      allow delete: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
    }

    // ===== Study Groups =====
    match /studyGroups/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
      allow delete: if request.auth != null && (resource.data.ownerUID == request.auth.uid || isAnyAdmin());
    }

    // ===== Polls =====
    match /polls/{id} {
      allow read: if request.auth != null;
      allow create: if isAnyAdmin() || request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAnyAdmin();
    }

    // ===== Forum =====
    match /forumThreads/{threadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.authorUID == request.auth.uid || isAnyAdmin());
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.authorUID == request.auth.uid);

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (resource.data.authorUID == request.auth.uid || isAnyAdmin());
        allow delete: if isAnyAdmin() || (request.auth != null && resource.data.authorUID == request.auth.uid);
      }
    }

    // ===== Lost & Found =====
    match /lostAndFound/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.reporterUID == request.auth.uid || isAnyAdmin());
      allow delete: if isAnyAdmin() || (request.auth != null && resource.data.reporterUID == request.auth.uid);
    }

    // ===== Reports (Moderation) =====
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAnyAdmin();
    }

    // ===== QR Login Sessions =====
    match /qrSessions/{sessionId} {
      // Anyone can read a specific session by its random UUID
      allow get: if true;
      allow list: if false;
      // Clients can create pending sessions but cannot inject uid or token
      allow create: if request.resource.data.status == 'pending' 
                    && !('uid' in request.resource.data) 
                    && !('customToken' in request.resource.data);
      // Updates/Deletions handled strictly by Cloud Functions (Admin SDK)
      allow update, delete: if false;
    }

    // ===== WebRTC Calls =====
    match /calls/{callId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerUID;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.callerUID || request.auth.uid == resource.data.calleeUID
      );
      
      match /offerCandidates/{docId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUID ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUID
        );
      }
      match /answerCandidates/{docId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUID ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUID
        );
      }
    }

    // ===== Deny all other access =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
